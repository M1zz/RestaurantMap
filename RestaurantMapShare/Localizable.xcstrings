    "글에서 가게를 찾지 못했어요. 가게 이름을 검색해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글에서 가게를 찾지 못했어요. 가게 이름을 검색해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find the place in this post. Try searching its name."
          }
        },
