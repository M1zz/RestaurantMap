        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top 6 最多只能设置 6 家（目前：%lld/6）"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
