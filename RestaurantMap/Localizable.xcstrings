    "대비를 높이거나 색을 구별하기 어려워도 지도와 목록을 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: colors and contrast",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the map and lists easily, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 지도와 목록을 알아볼 수 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read the map and lists easily, even with Increase Contrast on or if colors are hard to tell apart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げたり、色の区別がつきにくい場合でも、地図とリストを見分けられます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使开启“增强对比度”或不易分辨颜色，也能看清地图和列表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使開啟「提高對比」或不易分辨顏色，也能看清地圖和清單。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта и списки читаются легко, даже при повышенной контрастности или проблемах с различением цветов."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue el mapa y las listas con facilidad, incluso con más contraste o si te cuesta diferenciar colores."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karte und Listen bleiben gut erkennbar – auch bei erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repérez facilement la carte et les listes, même avec un contraste renforcé ou une difficulté à distinguer les couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mappa ed elenchi restano leggibili anche con contrasto elevato o se fai fatica a distinguere i colori."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o mapa e as listas com facilidade, mesmo com contraste aumentado ou dificuldade para distinguir cores."
          }
        }
      }
    },
