    "탑6는 최대 6개까지만 지정할 수 있습니다 (현재: %lld/6)" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탑6는 최대 6개까지만 지정할 수 있습니다 (현재: %lld/6)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can pick up to 6 Top 6 restaurants (currently %lld/6)"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can pick up to 6 Top 6 restaurants (currently %lld/6)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top 6は最大6件まで選べます (現在: %lld/6)"
          }
