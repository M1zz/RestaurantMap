          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Top 6 können höchstens 6 Restaurants enthalten (aktuell: %lld/6)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Top 6 est limité à 6 restaurants (actuellement : %lld/6)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Top 6 può contenere al massimo 6 ristoranti (ora: %lld/6)"
          }
