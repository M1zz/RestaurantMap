    "각 항목의 맛 강도와 만족도를 평가해주세요. 평가는 선택 사항입니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목의 맛 강도와 만족도를 평가해주세요. 평가는 선택 사항입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate the flavor intensity and satisfaction for each item. Rating is optional."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate the flavour intensity and satisfaction for each item. Rating is optional."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目の味の強さと満足度を評価してください。評価は任意です。"
