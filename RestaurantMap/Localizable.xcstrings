        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방문 기록을 적다가 앱이 꺼져도 쓰던 내용이 남아 있어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you were writing about a visit stays put, even if the app closes mid-way."
          }
