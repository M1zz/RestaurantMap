    "현재 데이터를 iCloud에 백업합니다. 기존 백업이 있다면 덮어씌워집니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 데이터를 iCloud에 백업합니다. 기존 백업이 있다면 덮어씌워집니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backs up your current data to iCloud. Any existing backup will be overwritten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backs up your current data to iCloud. Any existing backup will be overwritten."
          }
