    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: larger text layouts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screens rearrange neatly instead of getting cut off when you enlarge text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字サイズを大きくしても、切れることなく見やすく配置し直されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字体后，界面会重新排布，内容不会被截断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "放大字體後，畫面會重新排版，內容不會被截斷。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При увеличении шрифта экраны перестраиваются, и текст не обрезается."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al aumentar el tamaño del texto, las pantallas se reorganizan sin cortarse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei größerer Schrift ordnen sich die Bildschirme neu an, ohne dass etwas abgeschnitten wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand vous agrandissez le texte, les écrans se réorganisent sans rien couper."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ingrandisci il testo, le schermate si riorganizzano senza tagliare nulla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao aumentar o tamanho do texto, as telas se reorganizam sem cortar nada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อขยายขนาดตัวอักษร หน้าจอจะจัดเรียงใหม่ ไม่ถูกตัดขาด"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi phóng to chữ, màn hình sẽ tự sắp xếp lại và không bị cắt."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při zvětšení textu se obrazovky přeskupí, aniž by se cokoli oříznulo."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gør teksten større, ordnes skærmene om, så intet bliver skåret af."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν μεγαλώνετε το κείμενο, οι οθόνες αναδιατάσσονται χωρίς να κόβεται τίποτα."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun suurennat tekstiä, näytöt järjestyvät uudelleen eikä mitään leikkaudu pois."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ukuran teks diperbesar, tampilan ditata ulang dan tidak ada yang terpotong."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du gjør teksten større, ordnes skjermene om uten at noe kuttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de tekst vergroot, worden schermen opnieuw ingedeeld zonder dat er iets wordt afgekapt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po powiększeniu tekstu ekrany układają się na nowo i nic nie jest ucięte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du förstorar texten ordnas skärmarna om utan att något klipps av."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metni büyüttüğünüzde ekranlar, hiçbir şey kesilmeden yeniden düzenlenir."
          }
        }
      }
    },
