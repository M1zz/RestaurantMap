    "모든 가게와 방문 기록이 삭제됩니다. 이 작업은 되돌릴 수 없습니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 가게와 방문 기록이 삭제됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All restaurants and visit records will be deleted. This can’t be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All restaurants and visit records will be deleted. This can’t be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのお店と訪問記録が削除されます。この操作は取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有餐厅和到访记录都将被删除。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有餐廳和造訪紀錄都將被刪除。此操作無法復原。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все рестораны и записи о визитах будут удалены. Это действие нельзя отменить."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todos los restaurantes y registros de visitas. Esta acción no se puede deshacer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Restaurants und Besuchseinträge werden gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les restaurants et enregistrements de visite seront supprimés. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i ristoranti e le visite registrate verranno eliminati. L’operazione non si può annullare."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os restaurantes e registros de visita serão excluídos. Esta ação não pode ser desfeita."
          }
        }
      }
    },
