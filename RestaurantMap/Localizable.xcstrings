    "각 항목의 맛 강도와 만족도를 평가해주세요. 평가는 선택 사항입니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 항목의 맛 강도와 만족도를 평가해주세요. 평가는 선택 사항입니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate the flavor intensity and satisfaction for each item. Rating is optional."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rate the flavour intensity and satisfaction for each item. Rating is optional."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各項目の味の強さと満足度を評価してください。評価は任意です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请为每一项评价口味浓淡和满意度。评价为可选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請為每一項評價口味濃淡與滿意度。評價為選填。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оцените насыщенность вкуса и удовлетворённость по каждому пункту. Оценка необязательна."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valora la intensidad del sabor y la satisfacción de cada elemento. La valoración es opcional."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewerte bei jedem Punkt Geschmacksintensität und Zufriedenheit. Die Bewertung ist optional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez l’intensité du goût et la satisfaction pour chaque élément. La note est facultative."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valuta intensità del sapore e soddisfazione per ogni voce. La valutazione è facoltativa."
