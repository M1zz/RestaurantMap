    "iCloud의 백업 데이터로 복구합니다. 현재 기기의 모든 데이터가 삭제되고 백업 데이터로 대체됩니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud의 백업 데이터로 복구합니다. 현재 기기의 모든 데이터가 삭제되고 백업 데이터로 대체됩니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores from your iCloud backup. All data on this device will be deleted and replaced with the backup."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores from your iCloud backup. All data on this device will be deleted and replaced with the backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudのバックアップから復元します。この端末のすべてのデータが削除され、バックアップの内容に置き換わります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从 iCloud 备份恢复。本设备上的所有数据都会被删除，并替换为备份中的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將從 iCloud 備份還原。此裝置上的所有資料都會被刪除，並替換為備份中的資料。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Данные будут восстановлены из копии в iCloud. Все данные на этом устройстве будут удалены и заменены данными из копии."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se restaurará desde tu copia de iCloud. Todos los datos de este dispositivo se eliminarán y se sustituirán por los de la copia."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die Daten aus deinem iCloud-Backup wieder her. Alle Daten auf diesem Gerät werden gelöscht und durch das Backup ersetzt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaure depuis votre sauvegarde iCloud. Toutes les données de cet appareil seront supprimées et remplacées par celles de la sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina dal backup di iCloud. Tutti i dati su questo dispositivo verranno eliminati e sostituiti da quelli del backup."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura a partir do seu backup do iCloud. Todos os dados deste dispositivo serão apagados e substituídos pelos do backup."
          }
        }
      }
    },
