    "현재 데이터를 iCloud에 백업합니다. 기존 백업이 있다면 덮어씌워집니다." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 데이터를 iCloud에 백업합니다. 기존 백업이 있다면 덮어씌워집니다."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backs up your current data to iCloud. Any existing backup will be overwritten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backs up your current data to iCloud. Any existing backup will be overwritten."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のデータをiCloudにバックアップします。既存のバックアップは上書きされます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将当前数据备份到 iCloud。已有的备份会被覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將目前資料備份到 iCloud。既有的備份會被覆寫。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущие данные будут скопированы в iCloud. Существующая копия будет заменена."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia los datos actuales en iCloud. Cualquier copia existente se sobrescribirá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert deine aktuellen Daten in iCloud. Ein vorhandenes Backup wird überschrieben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde vos données actuelles sur iCloud. Toute sauvegarde existante sera remplacée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue il backup dei dati attuali su iCloud. Un eventuale backup esistente verrà sovrascritto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz backup dos dados atuais no iCloud. Qualquer backup existente será substituído."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำรองข้อมูลปัจจุบันไปที่ iCloud ข้อมูลสำรองเดิมจะถูกเขียนทับ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao lưu dữ liệu hiện tại lên iCloud. Bản sao lưu cũ (nếu có) sẽ bị ghi đè."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zazálohuje aktuální data na iCloud. Případná existující záloha bude přepsána."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tager backup af dine nuværende data til iCloud. En eksisterende backup overskrives."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δημιουργεί αντίγραφο ασφαλείας των τρεχόντων δεδομένων στο iCloud. Τυχόν υπάρχον αντίγραφο θα αντικατασταθεί."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopioi nykyiset tiedot iCloudiin. Mahdollinen aiempi varmuuskopio korvataan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencadangkan data saat ini ke iCloud. Cadangan yang sudah ada akan ditimpa."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sikkerhetskopierer gjeldende data til iCloud. En eksisterende sikkerhetskopi overskrives."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt een back-up van je huidige gegevens in iCloud. Een bestaande back-up wordt overschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy kopię bieżących danych w iCloud. Istniejąca kopia zostanie zastąpiona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säkerhetskopierar nuvarande data till iCloud. En befintlig säkerhetskopia skrivs över."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mevcut verileri iCloud’a yedekler. Varsa önceki yedeğin üzerine yazılır."
          }
        }
      }
    },
